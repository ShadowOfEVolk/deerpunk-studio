<rml>
    <head>
        <title>Binding Test</title>
        <style>
            body {
                display: block;
                width: 400px;
                height: 300px;
                background-color: rgb(38, 52, 80);
            }
            #root {
                display: block;
                background-color: rgb(90, 60, 110);
                width: 300px;
                height: 200px;
            }
            button {
                display: block;
                background-color: rgb(167, 139, 250);
                width: 120px;
                height: 40px;
            }
            .row {
                display: block;
                background-color: rgb(60, 110, 90);
                width: 200px;
                height: 30px;
            }
        </style>
    </head>
    <body>
        <div id="root">
            <button id="play" data-event-click="on_play">{{label}}</button>
            <div data-for="item in items">{{item.name}}</div>
            <span data-class-active="{{flag}}">count {{count}}</span>
            <div class="row" data-visible="{{ready}}">ready</div>
        </div>
    </body>
</rml>
